APP_NAME=NunezOrganizer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Docker: http://localhost:${NUNEZ_HTTP_PORT}. Native: wherever you serve public/.
APP_URL=http://localhost:8480

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Registration: invite (default) | approval | open
NUNEZ_REGISTRATION_MODE=invite
NUNEZ_INVITATION_TTL_DAYS=7

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB is the authoritative database (dev, CI, production).
# With the Docker dev stack use DB_HOST=mariadb; with a native MariaDB use 127.0.0.1.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=nunezorganizer
DB_USERNAME=nunezorganizer
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Mailpit (Docker dev stack) UI: http://localhost:8482
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nunezorganizer.test"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram (M4). Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ROUTE_KEY=

VITE_APP_NAME="${APP_NAME}"

# --- Docker development environment (docker-compose.yml) -----------------------
# Host ports, all bound to 127.0.0.1. Change any that clash with other software;
# keep APP_URL's port in sync with NUNEZ_HTTP_PORT. Xdebug: VS Code listens on
# NUNEZ_XDEBUG_PORT (also set "port" in .vscode/launch.json if you change it).
NUNEZ_HTTP_PORT=8480
NUNEZ_PMA_PORT=8481
NUNEZ_MAILPIT_PORT=8482
NUNEZ_VITE_PORT=5480
NUNEZ_DB_PORT=33480
NUNEZ_XDEBUG_PORT=9013
# XDEBUG_MODE=debug               # "off" to disable, "coverage" for test coverage, "debug,develop" for dev helpers
# XDEBUG_MODE_WORKERS=off         # Xdebug for the queue/scheduler containers
# MARIADB_VERSION=10.11           # e.g. 10.6 to match an older production server
# UID=1000                        # Linux hosts: your `id -u` / `id -g`
# GID=1000
