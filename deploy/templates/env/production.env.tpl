# NunezOrganizer production environment. Lives at {{APP_ROOT}}/shared/.env (0600, {{APP_USER}}).
# Generated by deploy/bin/bootstrap-layout.sh. Validate with deploy/bin/check-env.sh.
# After editing: cd {{APP_ROOT}}/current && php artisan config:cache && php artisan queue:restart

APP_NAME=NunezOrganizer
APP_ENV=production
APP_KEY={{APP_KEY_VALUE}}
APP_DEBUG=false
APP_URL={{APP_URL}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST={{DB_HOST}}
DB_PORT={{DB_PORT}}
DB_DATABASE={{DB_NAME}}
DB_USERNAME={{DB_USER}}
# Set by deploy/bin/provision-database.sh --apply
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION={{QUEUE_CONNECTION}}
CACHE_STORE=database

# Verification and password-reset emails go through the server's local Exim.
# Deliverability depends on SPF/DKIM for the From domain (Webuzo -> Email -> DKIM).
MAIL_MAILER=sendmail
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_FROM_ADDRESS="{{MAIL_FROM_ADDRESS}}"
MAIL_FROM_NAME="${APP_NAME}"

NUNEZ_REGISTRATION_MODE=invite
NUNEZ_DEFAULT_TIMEZONE=UTC

# Telegram (M4). Fill in on the server only; never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ROUTE_KEY=

VITE_APP_NAME="${APP_NAME}"
