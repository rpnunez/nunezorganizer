# NunezOrganizer deployment configuration (issue #21).
#
# Copy to /etc/nunezorganizer/deploy.env (root:root 0644) on the server, or
# point NUNEZ_DEPLOY_CONFIG at another path. Every script in deploy/bin and
# deploy/bin/render-templates.sh reads this file. It is sourced by bash, so
# ${VAR} references work. It must NOT contain secrets: DB passwords live in
# the app's shared/.env and in the backup option file, both mode 0600.
#
# deploy/audit/vps-audit.sh (read-only) reports the paths to put here for a given server.

# --- Identity -----------------------------------------------------------------
APP_SLUG="nunezorganizer"
APP_USER="deploy"                         # Unix user that owns the app files and runs PHP for it
APP_GROUP="deploy"
APP_DOMAIN="organizer.example.com"
APP_URL="https://${APP_DOMAIN}"

# --- Layout -------------------------------------------------------------------
# APP_ROOT/
#   repo.git/        bare mirror used to cut releases
#   releases/<ts>-<sha>/
#   shared/.env      production env (0600)
#   shared/storage/  persistent Laravel storage
#   shared/logs/     deploy, backup and healthcheck logs
#   current -> releases/<ts>-<sha>
# The web server's document root must be ${APP_ROOT}/current/public.
APP_ROOT="/home/${APP_USER}/${APP_SLUG}"
REPO_URL="https://github.com/rpnunez/nunezorganizer.git"
DEFAULT_REF="master"
KEEP_RELEASES=5

# --- Toolchain ----------------------------------------------------------------
# PHP 8.4 CLI used for artisan/composer. Common locations:
#   Debian/Ubuntu (packages.sury.org / ondrej PPA)  /usr/bin/php8.4
#   RHEL/Alma/Rocky (Remi)                         /opt/remi/php84/root/usr/bin/php
#   Webuzo                                         /usr/local/apps/php84/bin/php
#   OpenLiteSpeed (LSPHP)                          /usr/local/lsws/lsphp84/bin/php
PHP_BIN="/usr/bin/php8.4"
PHP_MIN_VERSION_ID=80400
COMPOSER_BIN="/usr/local/bin/composer"
NPM_BIN="npm"
NODE_MIN_VERSION="22.18.0"                # the vite-plus asset build needs Node ^22.18

# --- Web server ---------------------------------------------------------------
# deploy/templates/{nginx,apache,php-fpm,openlitespeed}/ are rendered for reference;
# install the ones for your stack by hand (docs/install.md#web-server).
# PHP-FPM pool socket used by the nginx/apache templates (pool template: php-fpm/).
PHP_FPM_SOCKET="/run/php/${APP_SLUG}.sock"
SSL_CERT_FILE="/etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem"
SSL_KEY_FILE="/etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem"

# After each release/rollback swaps the `current` symlink, PHP must drop the old
# release's cached paths. release.sh runs WEB_RELOAD_CMD; the sudoers template lets
# APP_USER run exactly WEB_RELOAD_PRIVILEGED_CMD as root. Pick your stack:
#   nginx/apache + PHP-FPM   /usr/bin/systemctl reload php8.4-fpm
#   OpenLiteSpeed / Webuzo   /usr/local/lsws/bin/lswsctrl restart
# Set both to "" to reload by hand.
WEB_RELOAD_PRIVILEGED_CMD="/usr/bin/systemctl reload php8.4-fpm"
WEB_RELOAD_CMD="sudo -n ${WEB_RELOAD_PRIVILEGED_CMD}"

# OpenLiteSpeed only (templates/openlitespeed/).
OLS_ROOT="/usr/local/lsws"
OLS_VHOST_NAME="${APP_SLUG}"
OLS_EXTAPP_NAME="lsphp84-${APP_SLUG}"
OLS_LOG_DIR="${OLS_ROOT}/logs/vhosts/${APP_SLUG}"
LSPHP_BIN="${OLS_ROOT}/lsphp84/bin/lsphp"
PHP_LSAPI_CHILDREN=8

# Webuzo + OpenLiteSpeed profile (docs/runbook.md). Webuzo owns the vhost and the
# certificate; the Webuzo user owns the files. Uncomment and adjust:
#   APP_USER="<webuzo-user>"; APP_GROUP="<webuzo-user>"
#   APP_ROOT="/home/${APP_USER}/sites/${APP_DOMAIN}"   # Webuzo domain path: sites/<domain>/current/public
#   PHP_BIN="/usr/local/apps/php84/bin/php"; LSPHP_BIN="/usr/local/apps/php84/bin/lsphp"
#   WEB_RELOAD_PRIVILEGED_CMD="/usr/local/lsws/bin/lswsctrl restart"
#   SSL_CERT_FILE="/var/webuzo/users/${APP_USER}/ssl/${APP_DOMAIN}-combined.pem"
#   SSL_KEY_FILE="/var/webuzo/users/${APP_USER}/ssl/${APP_DOMAIN}.key"

# --- Queue worker & scheduler -------------------------------------------------
QUEUE_SUPERVISOR="systemd"                # systemd | supervisor
QUEUE_SERVICE="${APP_SLUG}-queue"
QUEUE_CONNECTION="database"
QUEUE_NAMES="notifications,default"
QUEUE_MAX_TIME=3600
QUEUE_MEMORY_MB=256

# --- Database (no passwords here) ---------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="nunezorganizer"
DB_USER="nunezorganizer"
DB_BACKUP_USER="nunezorganizer_bk"
DB_ADMIN_CLIENT="mariadb"                 # used by provision-database.sh as root (socket auth)

# --- Backups ------------------------------------------------------------------
BACKUP_DIR="/home/${APP_USER}/backups/${APP_SLUG}"
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION="gpg"                   # gpg | age  (never plaintext)
BACKUP_GPG_RECIPIENT=""                   # fingerprint of YOUR public key (the private key stays off the server)
BACKUP_GPG_HOME="/home/${APP_USER}/.config/${APP_SLUG}/gnupg"  # keyring holding only that public key
BACKUP_AGE_RECIPIENTS_FILE="/etc/nunezorganizer/backup-recipients.txt"  # if BACKUP_ENCRYPTION=age
BACKUP_DB_DEFAULTS_FILE="/home/${APP_USER}/.config/${APP_SLUG}/backup.my.cnf"  # 0600, written by provision-database.sh
BACKUP_MAX_AGE_HOURS=26                   # healthcheck alarm threshold
# Optional hook run after each successful backup with the new files as arguments,
# e.g. "rclone copy --no-traverse {} remote:nunez-backups" style wrapper script path.
BACKUP_OFFSITE_HOOK=""

# --- Mail ---------------------------------------------------------------------
# Sender for app email. The production .env template uses the local MTA
# (MAIL_MAILER=sendmail); switch it to smtp in shared/.env if the host has none.
MAIL_FROM_ADDRESS="no-reply@${APP_DOMAIN}"

# --- Monitoring ---------------------------------------------------------------
CRON_MAILTO=""                            # where cron/healthcheck alerts go (empty = nowhere)
HEALTHCHECK_MIN_FREE_MB=1024
HEALTHCHECK_REALERT_MINUTES=60
# Optional "host:port:address" passed to curl --resolve (e.g. before DNS is live).
HEALTHCHECK_RESOLVE=""
